diff --git i/hugs/System/IO/TimeMilli.hs w/hugs/System/IO/TimeMilli.hs
index 1c5597e..d4b5ee0 100644
--- i/hugs/System/IO/TimeMilli.hs
+++ w/hugs/System/IO/TimeMilli.hs
@@ -2,5 +2,12 @@ module System.IO.TimeMilli(getTimeMilli) where
 import Data.Time
 import Data.Time.Clock.POSIX
 
+-- Hugs's Int is 32 bits (prelude.h: typedef int Int, MAXPOSINT 0x7fffffff),
+-- but epoch milliseconds are ~1.7e12, so the Integer -> Int conversion raised
+-- an "arithmetic overflow" ArithException from bignums.c.  MicroHs only ever
+-- takes differences of these for timing reports, so reducing modulo 1e9 keeps
+-- every delta correct apart from one wrap every ~11.6 days.
 getTimeMilli :: IO Int
-getTimeMilli  = fmap (floor . (1000 *) . toRational . utcTimeToPOSIXSeconds) getCurrentTime
+getTimeMilli =
+  fmap (fromInteger . (`mod` 1000000000) . floor . (1000 *) . toRational . utcTimeToPOSIXSeconds)
+       getCurrentTime
diff --git i/hugs/Text/Read.hs w/hugs/Text/Read.hs
new file mode 100644
index 0000000..58be060
--- /dev/null
+++ w/hugs/Text/Read.hs
@@ -0,0 +1,10 @@
+-- Shim: Hugs predates Text.Read.readMaybe (base 4.6).
+module Text.Read(readMaybe, readEither) where
+
+readMaybe :: (Read a) => String -> Maybe a
+readMaybe s = case [ x | (x,t) <- reads s, ("","") <- lex t ] of
+                [x] -> Just x
+                _   -> Nothing
+
+readEither :: (Read a) => String -> Either String a
+readEither s = maybe (Left "Text.Read.readEither: no parse") Right (readMaybe s)
