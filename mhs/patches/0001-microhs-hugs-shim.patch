+-- Shim: Hugs's Data.Version predates makeVersion (base 4.8).
+module Data.Version(Version(..), makeVersion, showVersion) where
+
+data Version = Version { versionBranch :: [Int], versionTags :: [String] }
+  deriving (Eq, Ord, Show)
+
+makeVersion :: [Int] -> Version
+makeVersion b = Version b []
+
+showVersion :: Version -> String
+showVersion (Version b _) = foldr1 (\x y -> x ++ "." ++ y) (map show b)
