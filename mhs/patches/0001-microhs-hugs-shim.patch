diff --git i/hugs/System/Directory.hs w/hugs/System/Directory.hs
new file mode 100644
index 0000000..3e7b605
--- /dev/null
+++ w/hugs/System/Directory.hs
@@ -0,0 +1,28 @@
+-- Shim: Hugs's System.Directory (2006) is Haskell 98's Directory plus a
+-- few additions; MicroHs 0.16.8.0's Main.hs also wants listDirectory
+-- (directory 1.2.5, 2016). Hugs.Directory holds the primitives, and this
+-- module stands in front of Hugs's System.Directory on the search path
+-- (+Phugs:... before {Hugs}/packages/*, like the other shims here), so it
+-- re-exports them and adds the two functions MicroHs uses on top:
+-- createDirectoryIfMissing as Hugs's own module defines it, and
+-- listDirectory.
+module System.Directory(module Hugs.Directory, createDirectoryIfMissing, listDirectory) where
+import Hugs.Directory
+
+createDirectoryIfMissing :: Bool -> FilePath -> IO ()
+createDirectoryIfMissing parents dir = do
+  b <- doesDirectoryExist dir
+  case (b, parents, dir) of
+    (_,     _, "") -> return ()
+    (True,  _,  _) -> return ()
+    (_,  True,  _) -> mapM_ (createDirectoryIfMissing False) (ancestors dir)
+    (_, False,  _) -> createDirectory dir
+  where
+    -- the directory and its ancestors, shortest first ("/a", "/a/b", "/a/b/c")
+    ancestors d = filter (not . null) (scanl1 (\a c -> a ++ "/" ++ c) (splitSlash d))
+    splitSlash s = case break (== '/') s of
+                     (a, [])    -> [a]
+                     (a, _ : r) -> a : splitSlash r
+
+listDirectory :: FilePath -> IO [FilePath]
+listDirectory d = fmap (filter (\f -> f /= "." && f /= "..")) (getDirectoryContents d)
