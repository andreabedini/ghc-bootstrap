# alex 2.1.0, whose -g output is GHC 6.6's shipped Lexer.hs and CmmLex.hs,
# compiled by the chain's GHC 6.2.2 (nix/ghc622/inst.nix) without Cabal,
# from its Hackage tarball (alex 2.0.x is no longer published anywhere).
#
# src/Parser.hs is regenerated by happy 1.16 -agc (nix/ghc66/happy116.nix) and must
# equal the tarball's. src/Scan.hs, alex's own lexer, can only come from an
# alex, so the tarball's is the seed, discharged by a fixed point:
#
#   gen 1  built with the tarball's Scan.hs; its `alex Scan.x` must equal
#          that Scan.hs (nix/ghc66/cmp-generated.sh)
#   gen 2  built with gen 1's Scan.hs; its `alex Scan.x` must be gen 1's,
#          byte for byte
#
# Templates: Setup.lhs's cpp step (nix/ghc66/cpp-template.sh). The one source change
# is nix/ghc66/shims622/Data/Version.hs, which 6.2.2's base lacks.
# Output: bin/alex (gen 2) and share/alex-2.1.0/ (the templates).
{ stdenv
, fetchurl
, perl
, gmp
, happy116
, ghc622
}:

stdenv.mkDerivation {
  pname = "alex";
  version = "2.1.0";
  src = fetchurl {
    url = "https://hackage.haskell.org/package/alex-2.1.0/alex-2.1.0.tar.gz";
    sha256 = "0b9c1246ca6ef27df4bfcb16d13cf7525d943ba2edc897d628605e1c9bd7d58b";
  };
  nativeBuildInputs = [ perl ];
  buildInputs = [ gmp ];
  hardeningDisable = [ "all" ];
  dontStrip = true;
  env = ghc622.nonPie;

  buildPhase = ''
    ulimit -s unlimited
    export TMPDIR=$NIX_BUILD_TOP/tmp; mkdir -p $TMPDIR
    ghc=${ghc622}/bin/ghc

    # Setup.lhs's `templates` and `wrappers` tables
    (cd templates
     t() { sh ${./cpp-template.sh} $ghc "$@"; }
     t GenericTemplate.hs AlexTemplate
     t GenericTemplate.hs AlexTemplate-ghc -DALEX_GHC
     t GenericTemplate.hs AlexTemplate-ghc-debug -DALEX_GHC -DALEX_DEBUG
     t GenericTemplate.hs AlexTemplate-debug -DALEX_DEBUG
     t wrappers.hs AlexWrapper-basic -DALEX_BASIC
     t wrappers.hs AlexWrapper-posn -DALEX_POSN
     t wrappers.hs AlexWrapper-monad -DALEX_MONAD
     t wrappers.hs AlexWrapper-gscan -DALEX_GSCAN)

    # what Cabal would generate
    cat > src/Paths_alex.hs <<EOF
    module Paths_alex (version, getDataDir) where
    import Data.Version
    version :: Version
    version = Version [2,1,0] []
    getDataDir :: IO FilePath
    getDataDir = return "$out/share/alex-2.1.0"
    EOF

    mkdir shipped; mv src/Parser.hs src/Scan.hs shipped/
    build() {   # $1 = generation: src/ -> ./alex-$1
      mkdir obj-$1
      (cd src && $ghc --make -v0 -cpp -fglasgow-exts -O -i${./shims622} -i. \
         -odir ../obj-$1 -hidir ../obj-$1 Main.hs -o ../alex-$1)
    }
    regen() {   # $1 = generation: its Scan.hs of src/Scan.x -> gen$1/ (run in src/,
                # as the release's was: the LINE pragmas name "Scan.x")
      mkdir gen$1; (cd src && ../alex-$1 -t ../templates Scan.x -o ../gen$1/Scan.hs)
    }

    ${happy116}/bin/happy -agc src/Parser.y -o src/Parser.hs
    sh ${./cmp-generated.sh} src/Parser.hs shipped/Parser.hs
    cp shipped/Scan.hs src/
    build 1; regen 1
    sh ${./cmp-generated.sh} gen1/Scan.hs shipped/Scan.hs
    cp gen1/Scan.hs src/
    build 2; regen 2
    cmp gen1/Scan.hs gen2/Scan.hs
    echo "alex 2.1.0: fixed point, gen 2 regenerates gen 1's Scan.hs byte for byte"
  '';
  installPhase = ''
    install -Dm755 alex-2 $out/bin/alex
    mkdir -p $out/share/alex-2.1.0
    cp templates/AlexTemplate* templates/AlexWrapper* $out/share/alex-2.1.0/
    mkdir -p $out/share/alex-2.1.0/generated; cp gen2/Scan.hs src/Parser.hs $out/share/alex-2.1.0/generated/
  '';
  doInstallCheck = true;
  installCheckPhase = "$out/bin/alex --version | grep -q 'Alex version 2.1.0'";
}
