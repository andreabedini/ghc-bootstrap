# happy 1.16, the version that generated GHC 6.6's Parser.hs and
# ParserCore.hs, compiled by the chain's GHC 6.2.2 (nix/ghc622-inst.nix)
# without Cabal, from its Hackage tarball, and with none of the parsers that
# tarball ships:
#
#   gen 1  src/Parser.hs and src/AttrGrammarParser.hs by the chain's happy
#          1.19.5 (plus phase4/fix-generated-parsers.sh for GHC 6.2.2)
#   gen 2  the same two parsers regenerated by gen 1 with -agc, as the
#          release's were; gen 2 regenerates them again and the build fails
#          unless its output is gen 1's, byte for byte (the fixed point)
#
# The release's src/Parser.hs must equal gen 1's (nix/cmp-generated.sh);
# AttrGrammarParser.hs cannot: happy 1.15 made it, with different code.
# Templates: Setup.lhs's cpp step (nix/cpp-template.sh). The one source change
# is nix/shims622/Data/Version.hs, which 6.2.2's base lacks.
# Output: bin/happy (gen 2) and share/happy-1.16/ (the templates).
{ stdenv
, fetchurl
, perl
, gmp
, happy
, ghc622-inst
}:

stdenv.mkDerivation {
  pname = "happy";
  version = "1.16";
  src = fetchurl {
    url = "https://hackage.haskell.org/package/happy-1.16/happy-1.16.tar.gz";
    sha256 = "4da47f4904dbdddfb58140edb0395383feba72dfc77759e57587a526dd9496c5";
  };
  nativeBuildInputs = [ perl ];
  buildInputs = [ gmp ];
  hardeningDisable = [ "all" ];
  dontStrip = true;
  env = ghc622-inst.nonPie;

  buildPhase = ''
    ulimit -s unlimited
    export TMPDIR=$NIX_BUILD_TOP/tmp; mkdir -p $TMPDIR
    ghc=${ghc622-inst}/bin/ghc

    # Setup.lhs's `templates` table (the GLR templates are not needed here)
    (cd templates
     t() { sh ${./cpp-template.sh} $ghc GenericTemplate.hs "$@"; }
     t HappyTemplate
     t HappyTemplate-ghc -DHAPPY_GHC
     t HappyTemplate-coerce -DHAPPY_GHC -DHAPPY_COERCE
     t HappyTemplate-arrays -DHAPPY_ARRAY
     t HappyTemplate-arrays-ghc -DHAPPY_ARRAY -DHAPPY_GHC
     t HappyTemplate-arrays-coerce -DHAPPY_ARRAY -DHAPPY_GHC -DHAPPY_COERCE
     t HappyTemplate-arrays-debug -DHAPPY_ARRAY -DHAPPY_DEBUG
     t HappyTemplate-arrays-ghc-debug -DHAPPY_ARRAY -DHAPPY_GHC -DHAPPY_DEBUG
     t HappyTemplate-arrays-coerce-debug -DHAPPY_ARRAY -DHAPPY_GHC -DHAPPY_COERCE -DHAPPY_DEBUG)

    # what Cabal would generate
    cat > src/Paths_happy.hs <<EOF
    module Paths_happy (version, getDataDir) where
    import Data.Version
    version :: Version
    version = Version [1,16] []
    getDataDir :: IO FilePath
    getDataDir = return "$out/share/happy-1.16"
    EOF

    mkdir shipped; mv src/Parser.hs src/AttrGrammarParser.hs shipped/
    build() {   # $1 = generation: src/ -> ./happy-$1
      mkdir obj-$1
      (cd src && $ghc --make -v0 -cpp -fglasgow-exts -O -i${./shims622} -i. \
         -odir ../obj-$1 -hidir ../obj-$1 Main.lhs -o ../happy-$1)
    }
    regen() {   # $1 = generation: its parsers of src/*.ly -> gen$1/
      mkdir gen$1
      for p in Parser AttrGrammarParser; do ./happy-$1 -agc -t templates src/$p.ly -o gen$1/$p.hs; done
    }

    for p in Parser AttrGrammarParser; do ${happy}/bin/happy src/$p.ly -o src/$p.hs; done
    sh ${../phase4/fix-generated-parsers.sh} src/Parser.hs src/AttrGrammarParser.hs
    build 1; regen 1
    sh ${./cmp-generated.sh} gen1/Parser.hs shipped/Parser.hs
    cp gen1/Parser.hs gen1/AttrGrammarParser.hs src/
    build 2; regen 2
    cmp gen1/Parser.hs gen2/Parser.hs
    cmp gen1/AttrGrammarParser.hs gen2/AttrGrammarParser.hs
    echo "happy 1.16: fixed point, gen 2 regenerates gen 1's parsers byte for byte"
  '';
  installPhase = ''
    install -Dm755 happy-2 $out/bin/happy
    mkdir -p $out/share/happy-1.16
    cp templates/HappyTemplate* $out/share/happy-1.16/
    mkdir -p $out/share/happy-1.16/generated; cp gen2/*.hs $out/share/happy-1.16/generated/
  '';
  doInstallCheck = true;
  installCheckPhase = "$out/bin/happy --version | grep -q 'Happy Version 1.16'";
}
