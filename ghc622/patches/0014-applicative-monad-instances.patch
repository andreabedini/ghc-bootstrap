--- a/ghc/compiler/ghci/ByteCodeItbls.lhs
+++ b/ghc/compiler/ghci/ByteCodeItbls.lhs
@@ -294,11 +294,26 @@
 
 newtype State s m a = State (s -> m (s, a))
 
+-- mhs has the modern class hierarchy: Monad needs Functor and Applicative
+-- above it.
+-- (mhs wants MonadFail m for a tuple pattern in a lambda under >>=, so the
+-- pairs are taken apart with case instead.)
+instance Monad m => Functor (State s m) where
+  fmap f (State m) = State (\s -> m s >>= \p -> case p of (s', a) -> return (s', f a))
+
+instance Monad m => Applicative (State s m) where
+  pure a            = State (\s -> return (s, a))
+  State f <*> State x = State (\s -> f s >>= \p -> case p of
+                          (s', g) -> x s' >>= \q -> case q of
+                            (s'', a) -> return (s'', g a))
+
 instance Monad m => Monad (State s m) where
   return a      = State (\s -> return (s, a))
-  State m >>= k = State (\s -> m s >>= \(s', a) -> case k a of State n -> n s')
-  fail str      = State (\s -> fail str)
+  State m >>= k = State (\s -> m s >>= \p -> case p of (s', a) -> case k a of State n -> n s')
 
+-- fail moved out of Monad in modern base.
+instance MonadFail m => MonadFail (State s m) where
+  fail str      = State (\s -> fail str)
 class (Monad m, Monad (t m)) => MonadT t m where
   lift :: m a -> t m a
 
