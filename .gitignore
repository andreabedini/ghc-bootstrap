/build/ghc622-mhs/diag/topdir-rebuild/
/build/ghc622-mhs/test/ifaces/
/build/ghc622-mhs/test/*.txt
/build/ghc622-stage2/stage2/
/build/ghc622-stage2/obj/
/build/ghc622-stage2/logs/

# ...nor generated sources a tracked script reproduces
/build/gen622/parser/
/build/gen622/main/
/build/gen622/prelude/
/build/lexer622/Lexer.hs
/build/lexer622/work/
/build/happy-mhs/*.hs
/build/happy-mhs/*.c
/build/happy-mhs/gen2/
/build/happy-mhs/gen3/
/build/ghc-parsers/
/build/ghc-parsers-6.0/
