# What is tracked: the writing (*.md), the patch series, the scripts, the
# shims, the boot files, order files and result tables -- everything a person
# wrote or that records a result. What is not: anything downloaded (see
# SOURCES.md), any extraction of a tarball, any clone of another project, and
# anything a script can regenerate (objects, interfaces, binaries, caches).

# ---- downloaded inputs; names, sha256 and where to get them: SOURCES.md ----
/*.tar.bz2
/*.tar.gz
/MicroHs/

# ---- nix-build's links into the store (default.nix) ----
/result
/result-*

# ---- phase0: the Hugs extraction and its install prefix ----
/phase0/hugs98-plus-Sep2006/
/phase0/prefix/

# ---- build/: only hand-written inputs and result tables are tracked ----
/build/**
!/build/**/
!/build/**/*.md
!/build/**/*.sh
!/build/**/*.py
!/build/**/*.pl
!/build/**/*.patch
!/build/**/*.tsv
!/build/**/*.txt
!/build/**/*.conf
!/build/**/*.hs
!/build/**/*.lhs
!/build/**/*.hs-boot
!/build/**/*.c
!/build/**/*.h
!/build/**/*.out
!/build/**/*.err
!/build/Makefile
!/build/hsc2hs-mhs/hsc2hs
!/build/happy-mhs/datadir/HappyTemplate
!/build/ppwrap/cpphs
!/build/ghc66-by-622/ghc622-inst/bin/ghc
!/build/ghc66-by-622/ghc622-inst/bin/ghc-pkg

# ...except inside tarball extractions and patched copies of them
/build/downloads/
/build/ghc-4.08.2/
/build/ghc-6.0/
/build/ghc-6.0-run2/
/build/ghc-6.0-slit/
/build/ghc-6.2.2/
/build/ghc-6.2.2-run1/ghc/
/build/rebase622/ghc-6.0/
/build/rebase622/ghc-6.2.2/
/build/rebase622/try622/
/build/rts622/ghc-6.2.2/
/build/repro-622/
/build/happy-1.16/
/build/happy-1.19.5/
/build/ghc622-mhs/libraries/
/build/ghc622-stage2/src/
/build/ghc622-stage2/libraries/
/build/lexer622/includes/
/build/ghc66-by-622/src/
/build/ghc66-by-622/src-verify/
/build/ghc66-by-622/ghc622-inst/src/

# ...and not the outputs: objects, interfaces, Abstract C, archives, binaries
/build/ghc-mhs/
/build/hello/
/build/rts622/obj/
/build/ghc622-mhs/hcobj/
/build/ghc622-mhs/cbitsobj/
/build/ghc622-mhs/lib/
/build/ghc622-mhs/base-logs/
/build/ghc622-mhs/ghc.c
/build/ghc622-mhs/ghc-data.c
/build/ghc622-mhs/diag/ifaces/
/build/ghc622-mhs/diag/ifaces-rebuild/
/build/ghc622-mhs/diag/logs/
/build/ghc622-mhs/diag/out/
/build/ghc622-mhs/diag/base-rebuild-logs/
/build/ghc622-mhs/diag/topdir-rebuild/
/build/ghc622-mhs/test/ifaces/
/build/ghc622-mhs/test/*.txt
/build/ghc622-stage2/stage2/
/build/ghc622-stage2/obj/
/build/ghc622-stage2/logs/

# ...nor generated sources a tracked script reproduces
/build/gen622/parser/
/build/gen622/main/
/build/gen622/prelude/
/build/lexer622/Lexer.hs
/build/lexer622/work/
/build/happy-mhs/*.hs
/build/happy-mhs/*.c
/build/happy-mhs/gen2/
/build/happy-mhs/gen3/
/build/ghc-parsers/
/build/ghc-parsers-6.0/
/build/ghc-hsboot/
/build/genprimopcode/

# ...nor probe caches, scratch experiments and superseded duplicates
/build/probe-*/
/build/scan-*/
/build/ppkeep/
/build/tools-ghc/
/build/*.out
/build/.stale-*/

# ---- caches, scratch and tool state, anywhere ----
.mhscache
.mhscache*
out.comb
tmp/
*.log
READY
__pycache__/
*.pyc
.claude/
.mcp.json
.idea/
.vscode/
