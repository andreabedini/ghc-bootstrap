# What is tracked: the writing (*.md), the patch series, the scripts, the
# shims, the boot files, order files and result tables -- everything a person
# wrote or that records a result. What is not: anything downloaded (see
# SOURCES.md), any extraction of a tarball, any clone of another project, and
# anything a script can regenerate (objects, interfaces, binaries, caches).

# ---- downloaded inputs; names, sha256 and where to get them: SOURCES.md ----
/*.tar.bz2
/*.tar.gz
/MicroHs/

# ---- nix-build's links into the store (default.nix) ----
/result
/result-*

# ---- the Hugs extraction and install prefix before 2026-10-08 (now build/hugs) ----
/phase0/

# ---- build/: only what we wrote, listed, plus the result tables README.md ----
# ---- and the FINDINGS files cite; everything else in it is output ----
/build/**
!/build/**/
# the manual 6.2.2 chain: Makefile, scripts, notes
!/build/Makefile
!/build/**/*.sh
!/build/**/*.py
!/build/**/*.pl
!/build/**/*.md
!/build/ghc622-mhs/SWITCH-NOTE.txt
# hand-written inputs: orders, wrappers, topdirs (symlinks into ghc622/)
!/build/ghc622-mhs/base-order.txt
!/build/hsc2hs-mhs/hsc-order.txt
!/build/hsc2hs-mhs/hsc2hs
!/build/ghc66-by-622/ghc622-inst/bin/ghc
!/build/ghc66-by-622/ghc622-inst/bin/ghc-pkg
!/build/ghc622-mhs/topdir/ghc-usage.txt
!/build/ghc622-mhs/topdir/package.conf
!/build/ghc622-stage2/topdir/ghc-usage.txt
!/build/ghc622-stage2/topdir/package.conf
# hand-written sources: tests, probes, repros, shims, hs-boot files, C stubs
!/build/ghc622-mhs/test/*.hs
!/build/ghc622-mhs/test/rv/*.hs
!/build/ghc622-stage2/test/Hello.hs
!/build/ghc66-by-622/test/Hello.hs
!/build/ghc622-mhs/diag/repro/Intern.hs
!/build/ghc622-mhs/diag/faststring-intern.patch
!/build/lexer622/driver/Main.hs
!/build/probe/*.hs
!/build/rebase622/hsboot-6.2.2/*.hs-boot
!/build/shims-6.0/*.hs
!/build/shims-6.0-run2/**/*.hs
!/build/rts622/*.c
!/build/rts622/alias-test/*.c
# result tables cited by README.md or a FINDINGS file
!/build/order-6.2.2.txt
!/build/order-6.2.2-pass2.txt
!/build/order-run4.txt
!/build/order-side1.txt
!/build/order-side2.txt
!/build/order-side3.txt
!/build/probe-6.2.2-run1-final.tsv
!/build/probe-6.2.2-run1-pass1.tsv
!/build/probe-6.2.2-run1-pass2.tsv
!/build/probe-side1.tsv
!/build/probe-side2.tsv
!/build/probe-side3.tsv
!/build/rebase622/build-order-6.2.2.txt
!/build/ghc622-mhs/base-results.tsv
!/build/ghc622-mhs/base-results-hsc.tsv
!/build/ghc622-mhs/diag/base-rebuild-results.tsv
!/build/ghc622-mhs/diag/base-rebuild-extra.tsv
!/build/ghc622-mhs/diag/scan-hi.txt
!/build/ghc622-mhs/diag/scan-hi-rebuild.txt

# ...except inside tarball extractions and work trees, whose scripts and
# READMEs are not ours
/build/hugs/
/build/ghc-6.2.2/
/build/ghc-6.2.2-run1/ghc/
/build/rebase622/ghc-6.2.2/
/build/rebase622/try622/
/build/rts622/ghc-6.2.2/
/build/repro-622/
/build/happy-1.19.5/
/build/hsc2hs-mhs/ghc/
/build/ghc622-stage2/src/
/build/ghc622-stage2/fixups/
/build/ghc622-stage2/libraries/
/build/ghc622-mhs/libraries/
/build/ghc66-by-622/src/
/build/ghc66-by-622/src-verify/
/build/ghc66-by-622/ghc622-inst/src/
/build/.stale-*/

# ---- caches, scratch and tool state, anywhere ----
.mhscache
.mhscache*
out.comb
tmp/
*.log
READY
__pycache__/
*.pyc
.claude/
.mcp.json
.idea/
.vscode/
