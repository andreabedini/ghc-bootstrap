# happy 1.20.1.1, the happy GHC 9.4 and 9.8 ask for (>= 1.20.0), compiled
# by the chain's GHC 9.0.2 with its own Setup.hs (Cabal 3.4), and with none
# of the parsers its Hackage tarball ships:
#
#   gen 1  src/Parser.hs and src/AttrGrammarParser.hs from the grammars
#          Parser.ly and AttrGrammarParser.ly by the chain's happy 1.19.5
#          (happy/happy.nix, plain backend: that happy has only the plain
#          template). The Hackage tarball does not carry the grammars, only
#          the generated modules, so they come from the 1.20.1.1 tag of
#          github.com/haskell/happy.
#   gen 2  the same two parsers regenerated by gen 1 with -agc, as the
#          release's were; gen 2 regenerates them again and the build fails
#          unless its output is gen 1's, byte for byte (the fixed point)
#
# gen 1's output must also equal the tarball's modulo blank lines, LINE
# pragmas (ghc66/cmp-generated.sh) and the one header line that names
# the generating happy: the release's parsers say "Happy Version 1.20.0".
# The grammars stay out of src/: Cabal runs happy -agc on any .ly it finds
# beside a module, and 1.19.5 cannot. Output: bin/happy (gen 2) and
# share/.../happy-1.20.1.1/ (the templates, through Paths_happy).
{ stdenv
, fetchurl
, gmp
, happy
, ghc90
}:

let
  grammar = name: sha256: fetchurl {
    url = "https://raw.githubusercontent.com/haskell/happy/1.20.1.1/src/${name}";
    inherit name sha256;
  };
  parserLy = grammar "Parser.ly" "97106be4951fabec0168133e2f37576ac60a0331d4031bfb73a8c575863fb187";
  attrLy = grammar "AttrGrammarParser.ly" "e822c731409a662baa44ae2310e3f1f5f22e6a869b81781ac86968e7af3a1a0e";
in
stdenv.mkDerivation {
  pname = "happy";
  version = "1.20.1.1";
  src = fetchurl {
    url = "https://hackage.haskell.org/package/happy-1.20.1.1/happy-1.20.1.1.tar.gz";
    sha256 = "8b4e7dc5a6c5fd666f8f7163232931ab28746d0d17da8fa1cbd68be9e878881b";
  };
  nativeBuildInputs = [ ghc90 happy ];
  buildInputs = [ gmp ];   # programs linked by 9.0.2 need -lgmp
  hardeningDisable = [ "all" ];
  dontStrip = true;
  env = ghc90.nonPie;

  buildPhase = ''
    runHook preBuild
    mkdir shipped grammar
    mv src/Parser.hs src/AttrGrammarParser.hs shipped/
    cp ${parserLy} grammar/Parser.ly
    cp ${attrLy} grammar/AttrGrammarParser.ly

    ghc --make -v0 Setup.hs -o Setup
    build() {   # $1 = generation: src/ -> ./happy-$1 (and a Cabal install tree inst-$1)
      rm -rf dist
      ./Setup configure -v0 --prefix=$PWD/inst-$1 --with-compiler=ghc --with-hc-pkg=ghc-pkg
      ./Setup build -v0
      ./Setup install -v0
      cp inst-$1/bin/happy happy-$1
    }
    regen() {   # $1 = generation: its -agc parsers of the grammars -> gen$1/
      mkdir gen$1
      for p in Parser AttrGrammarParser; do ./happy-$1 -agc grammar/$p.ly -o gen$1/$p.hs; done
    }
    for p in Parser AttrGrammarParser; do happy grammar/$p.ly -o src/$p.hs; done
    build 1; regen 1
    cp gen1/Parser.hs gen1/AttrGrammarParser.hs src/
    build 2; regen 2
    runHook postBuild
  '';
  doCheck = true;
  checkPhase = ''
    runHook preCheck
    for p in Parser AttrGrammarParser; do
      sed 's/^-- parser produced by Happy Version 1\.20\.0$/-- parser produced by Happy Version 1.20.1.1/' shipped/$p.hs > shipped/$p.hs.v
      sh ${../ghc66/cmp-generated.sh} gen1/$p.hs shipped/$p.hs.v
    done
    cmp gen1/Parser.hs gen2/Parser.hs
    cmp gen1/AttrGrammarParser.hs gen2/AttrGrammarParser.hs
    echo "happy 1.20.1.1: fixed point, gen 2 regenerates gen 1's parsers byte for byte"
    runHook postCheck
  '';
  installPhase = ''
    runHook preInstall
    rm -rf dist
    ./Setup configure -v0 --prefix=$out --with-compiler=ghc --with-hc-pkg=ghc-pkg
    ./Setup build -v0
    ./Setup install -v0
    mkdir -p $out/share/generated; cp gen2/*.hs $out/share/generated/
    runHook postInstall
  '';
  doInstallCheck = true;
  installCheckPhase = ''
    $out/bin/happy --version | grep -q 'Happy Version 1.20.1.1'
    cmp <($out/bin/happy -agc grammar/Parser.ly -o /dev/stdout) gen2/Parser.hs
  '';
}
