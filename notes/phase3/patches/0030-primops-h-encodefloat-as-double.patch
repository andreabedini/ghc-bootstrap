 #ifndef FLOATS_AS_DOUBLES
 extern StgFloat  __encodeFloat (I_ size, StgByteArray arr, I_ e);
 extern StgFloat  __int_encodeFloat (I_ j, I_ e);
+#else
+/* When StgFloat *is* StgDouble (StgTypes.h:99), StgPrimFloat.c compiles only
