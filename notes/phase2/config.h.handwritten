/* Generated by notes/phase2/mkconfig.sh -- not shipped in the tarball.
   x86_64 GNU/Linux, unregisterised. */
#ifndef GHC_CONFIG_H
#define GHC_CONFIG_H

/* little-endian: WORDS_BIGENDIAN stays undefined */
#undef WORDS_BIGENDIAN

/* ELF has no leading underscore on symbol names */
#define LEADING_UNDERSCORE 0

/* The compiler itself needs only WORDS_BIGENDIAN and LEADING_UNDERSCORE, but
   the RTS headers (StgTypes.h, InfoTables.h) need the full size set and a few
   HAVE_ probes -- they are included when compiling GHC's .hc output. */
#define SIZEOF_CHAR                 1
#define SIZEOF_UNSIGNED_CHAR        1
#define SIZEOF_SHORT                2
#define SIZEOF_UNSIGNED_SHORT       2
#define SIZEOF_INT                  4
#define SIZEOF_UNSIGNED_INT         4
#define SIZEOF_LONG                 8
#define SIZEOF_UNSIGNED_LONG        8
#define SIZEOF_LONG_LONG            8
#define SIZEOF_UNSIGNED_LONG_LONG   8
#define SIZEOF_VOID_P               8
#define SIZEOF_FLOAT                4
#define SIZEOF_DOUBLE               8

#define HAVE_LONG_LONG              1
#define HAVE_UNISTD_H               1
#define HAVE_SIGNAL_H               1
#define HAVE_STDINT_H               1
#define HAVE_SETITIMER              1
/* not Windows */
#undef  HAVE_WIN32_DLL_SUPPORT

#define HostPlatform_TYPE       x86_64_unknown_linux
#define TargetPlatform_TYPE     x86_64_unknown_linux
#define BuildPlatform_TYPE      x86_64_unknown_linux
#define x86_64_unknown_linux_HOST   1
#define x86_64_unknown_linux_TARGET 1
#define x86_64_unknown_linux_BUILD  1

#define HOST_OS                 "linux"
#define TARGET_OS               "linux"
#define HOST_ARCH               "x86_64"
#define TARGET_ARCH             "x86_64"

#endif /* GHC_CONFIG_H */
