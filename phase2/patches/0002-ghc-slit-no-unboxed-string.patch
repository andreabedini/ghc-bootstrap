--- a/ghc/compiler/HsVersions.h
+++ b/ghc/compiler/HsVersions.h
@@ -148,9 +148,16 @@
 import qualified FastString 
 #endif
 
+-- GHC 4.08 predates Semigroup, and defines its own (<>) for pretty-printing
+-- documents (Pretty/Outputable). Modern base exports Semigroup's (<>) from the
+-- Prelude, which makes every use in the compiler ambiguous. An explicit
+-- Prelude import suppresses the implicit one, so this hides just that name.
+import Prelude hiding ((<>))
+import GhcCompat
+
 # define USE_FAST_STRINGS 1
 # define FAST_STRING	FastString.FastString
-# define SLIT(x)	(FastString.mkFastCharString# (x#))
+# define SLIT(x)	(FastString.mkFastString x)
 # define _NULL_		FastString.nullFastString
 # define _NIL_		(FastString.mkFastString "")
 # define _CONS_		FastString.consFS
