diff -ru a/src/Map.hs b/src/Map.hs
--- a/src/Map.hs
+++ b/src/Map.hs
@@ -13,7 +13,19 @@

 import Prelude hiding ( lookup )

-#if __GLASGOW_HASKELL__ >= 603
+#if defined(__MHS__)
+import Data.Map
+
+-- The chain's Data.Map shim (common/shims) lacks these three.
+unionWith :: Ord k => (a -> a -> a) -> Map k a -> Map k a -> Map k a
+unionWith c l r = foldr (\(k,a) m -> insertWith c k a m) r (toAscList l)
+
+mapWithKey :: Ord k => (k -> a -> b) -> Map k a -> Map k b
+mapWithKey f m = fromList [ (k, f k a) | (k,a) <- toAscList m ]
+
+fromListWith :: Ord k => (a -> a -> a) -> [(k,a)] -> Map k a
+fromListWith c = foldl (\m (k,a) -> insertWith c k a m) empty
+#elif __GLASGOW_HASKELL__ >= 603
 import Data.Map
 #else
 import Data.FiniteMap
