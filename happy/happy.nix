# happy 1.19.5 compiled by mhs. Its own parsers (Parser.hs,
# AttrGrammarParser.hs) are generated by happy, so one generation has to be an
# input: happy-seed/ holds generation 2 of build/fixpoint-happy.sh, and the
# check phase fails unless the happy built from them regenerates them byte
# for byte.
# The portable template is `cpphs --noline templates/GenericTemplate.hs`.
{ stdenv, fetchurl, makeWrapper, mhs, cpphs }:
stdenv.mkDerivation {
  pname = "happy-mhs";
  version = "1.19.5";
  src = fetchurl {
    url = "https://hackage.haskell.org/package/happy-1.19.5/happy-1.19.5.tar.gz";
    sha256 = "62f03ac11d7b4b9913f212f5aa2eee1087f3b46dc07d799d41e1854ff02843da";
  };
  nativeBuildInputs = [ mhs cpphs makeWrapper ];
  hardeningDisable = [ "all" ];
  buildPhase = ''
    runHook preBuild
    mkdir datadir
    cpphs --noline templates/GenericTemplate.hs > datadir/HappyTemplate
    export HAPPY_DATADIR=$PWD/datadir
    cp ${./happy-seed}/*.hs src/
    mhs -XCPP -i${./noglr} -i${../common/shims} -i${./shim} -isrc \
        Main -ohappy.c
    cc -w -O1 -I${mhs}/src/runtime -I${mhs}/src/runtime/unix \
       ${mhs}/src/runtime/main.c ${mhs}/src/runtime/eval.c happy.c -lm -o happy
    mkdir regen
    for p in Parser AttrGrammarParser; do (cd src && ../happy $p.ly -o ../regen/$p.hs); done
    runHook postBuild
  '';
  doCheck = true;
  checkPhase = ''
    runHook preCheck
    for p in Parser AttrGrammarParser; do cmp regen/$p.hs src/$p.hs; done
    echo "fixpoint: happy regenerates its own parsers byte for byte"
    runHook postCheck
  '';
  installPhase = ''
    runHook preInstall
    install -Dm755 happy $out/libexec/happy
    install -Dm644 datadir/HappyTemplate $out/share/happy/HappyTemplate
    makeWrapper $out/libexec/happy $out/bin/happy \
      --set-default HAPPY_DATADIR $out/share/happy
    runHook postInstall
  '';
}
