GHC 6.2.2 -- mhs: arithmetic that must wrap, hFileSize, and exitWith
Found by running the linked compiler (DECISIONS.md D47), not by
typechecking. MicroHs traps where GHC wraps: fromInteger into
Int8/Int16/Int32 is checked (utils/Binary.hs's Integer sign byte,
basicTypes/Literal.lhs's narrow*Lit), and negate/abs of minBound raise
(coreSyn/CoreUtils.lhs's hashExpr). utils/Binary.hs's readBinMem needs a
file size and MicroHs handles have no hFileSize, so it reads the file
whole by path. main/DriverUtil.hs: with __GLASGOW_HASKELL__=408 the driver
takes its pre-5.01 catch-all branch, which swallows the ExitException
that every clean exit throws; the >= 501 branch is taken under __MHS__ too.
All under #if defined(__MHS__) or commented -- mhs.

--- a/ghc/compiler/basicTypes/Literal.lhs
+++ b/ghc/compiler/basicTypes/Literal.lhs
@@ -246,12 +246,23 @@
   | i < 0     = MachWord (1 + tARGET_MAX_WORD + i)	-- (-1)  --->  tARGET_MAX_WORD
   | otherwise = MachWord i
 
-narrow8IntLit    (MachInt  i) = MachInt  (toInteger (fromInteger i :: Int8))
-narrow16IntLit   (MachInt  i) = MachInt  (toInteger (fromInteger i :: Int16))
-narrow32IntLit   (MachInt  i) = MachInt  (toInteger (fromInteger i :: Int32))
-narrow8WordLit   (MachWord w) = MachWord (toInteger (fromInteger w :: Word8))
-narrow16WordLit  (MachWord w) = MachWord (toInteger (fromInteger w :: Word16))
-narrow32WordLit  (MachWord w) = MachWord (toInteger (fromInteger w :: Word32))
+-- mhs: these went through `fromInteger :: Integer -> Int8/Int16/Int32/Word8/
+-- ...`, which wraps modulo 2^n in Haskell 98 and GHC but *checks* in MicroHs
+-- (Data/Int/Int8.hs:32 `i8` -> `_overflowError`), so folding narrow8Int# on
+-- any value outside the target range raised "arithmetic overflow" instead of
+-- truncating. Do the truncation in Integer, which is what the primop means.
+narrowSigned, narrowUnsigned :: Int -> Integer -> Integer
+narrowUnsigned bits i = i `mod` (2 ^ bits)
+narrowSigned bits i = let m = 2 ^ bits
+                          u = i `mod` m
+                      in if u >= m `div` 2 then u - m else u
+
+narrow8IntLit    (MachInt  i) = MachInt  (narrowSigned    8 i)
+narrow16IntLit   (MachInt  i) = MachInt  (narrowSigned   16 i)
+narrow32IntLit   (MachInt  i) = MachInt  (narrowSigned   32 i)
+narrow8WordLit   (MachWord w) = MachWord (narrowUnsigned  8 w)
+narrow16WordLit  (MachWord w) = MachWord (narrowUnsigned 16 w)
+narrow32WordLit  (MachWord w) = MachWord (narrowUnsigned 32 w)
 
 char2IntLit (MachChar c) = MachInt  (toInteger c)
 int2CharLit (MachInt  i) = MachChar (fromInteger i)
