+#if defined(__MHS__)
+-- mhs: `fromInteger` into Int8/Int16/Int32 is *checked* in MicroHs
+-- (Data/Int/Int8.hs:32 `i8` -> `_overflowError`, likewise Int16/Int32), where
+-- Haskell 98 and GHC wrap modulo 2^n. These three instances read a word back
+-- as the signed value with the same bit pattern, so every 0x80..0xff byte --
+-- in particular the 0xff sign byte that `Binary Integer` below writes for
+-- every negative literal -- raised "arithmetic overflow" instead. Do the
+-- two's-complement fold by hand, in Integer, before narrowing.
+-- Int64 needs no such care: it is the machine word here and converts fine.
+mhsSigned :: (Num a) => Integer -> Integer -> a
+mhsSigned modulus u = fromInteger (if u >= modulus `div` 2 then u - modulus else u)
+
