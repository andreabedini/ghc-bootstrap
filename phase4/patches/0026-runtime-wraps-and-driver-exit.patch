 readBinMem :: FilePath -> IO BinHandle
+#if defined(__MHS__)
+-- mhs: MicroHs's handles cannot report a size (no hFileSize), and readBinMem
+-- is the only caller that needs one. It has the path, so read the file whole
+-- in binary mode -- byte for byte, no utf8 layer (System/IO/Open.hs:65) --
