+-- The 4.08 build used hslibs' MutableByteArray with newCharArray /
+-- readWord8Array / writeWord8Array and hPutBufBAFull / hGetBufBAFull. MicroHs
+-- has none of those; its Data.Array.Byte is the same abstraction in ST, and
+-- the file transfers are byte loops (cf. D20: reimplement, don't emulate).
+type BinArray = B.MutableByteArray RealWorld
+newArray_ (lo,hi)    = stToIO (B.newMutableEmptyByteArray (hi-lo+1))
+unsafeWrite arr ix e = stToIO (B.writeWord8 arr ix e)
+unsafeRead  arr ix   = stToIO (B.readWord8 arr ix)
+
+hPutArray :: Handle -> BinArray -> Int -> IO ()
+hPutArray h arr sz   = mapM_ (\i -> unsafeRead arr i >>= hPutChar h . chr . fromIntegral) [0 .. sz-1]
+
+hGetArray :: Handle -> BinArray -> Int -> IO Int
+hGetArray h arr sz   = loop 0
+  where loop i | i >= sz   = return i
+               | otherwise = do eof <- hIsEOF h
+                                if eof then return i else do
+                                  c <- hGetChar h
+                                  unsafeWrite arr i (fromIntegral (ord c))
+                                  loop (i+1)
 
